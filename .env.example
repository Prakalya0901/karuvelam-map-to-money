# Karuvelam Map-to-Money Environment Variables

# Server & Database Settings
PORT=8000
HOST=127.0.0.1
DATABASE_PATH=karuvelam.db

# Optional Google Earth Engine (GEE) Settings
# When left empty, the application operates smoothly in Demonstration Fallback Mode
# using calibrated Sentinel-2 surface reflectance datasets.
GEE_PROJECT_ID=
GEE_SERVICE_ACCOUNT=
GEE_KEY_FILE_PATH=

# CORS Settings
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
